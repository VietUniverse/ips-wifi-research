{
  "model": "bsrbf_kan",
  "preprocess": "rss_ap_robust",
  "preprocess_params": {
    "min_observations": 30,
    "lower_quantile": 10.0,
    "upper_quantile": 90.0,
    "min_unique_values": 3,
    "min_std_db": 1.0,
    "mask_low_information": true
  },
  "buildings": [
    0,
    1,
    2
  ],
  "seed": 42,
  "val_size": 0.15,
  "validation_group": "phone",
  "batch_size": 64,
  "stage1_epochs": 30,
  "stage2_epochs": 80,
  "stage2_lr": 0.0001,
  "metric_coordinate_loss": true,
  "patience": 15,
  "with_mixer": true,
  "mixer_arch": "ap_token",
  "mixer_token_type": "kan",
  "mixer_channel_type": "kan",
  "mixer_epochs": 50,
  "mixer_patience": 15,
  "mixer_batch_size": 64,
  "mixer_blocks": 1,
  "mixer_lr": 0.00015,
  "mixer_weight_decay": 0.0001,
  "mixer_metric_coordinate_loss": true,
  "spatial_clusters": 0,
  "balance_locations": true,
  "augment_gain_std": 0.28,
  "augment_noise_std": 0.1,
  "augment_dropout_prob": 0.15
}
