{
  "model": "bsrbf_kan",
  "preprocess": "rss_ap_robust",
  "preprocess_params": {
    "min_observations": 30,
    "lower_quantile": 10.0,
    "upper_quantile": 90.0,
    "min_unique_values": 3,
    "min_std_db": 1.0,
    "mask_low_information": true
  },
  "buildings": [0, 1, 2],
  "seed": 42,
  "val_size": 0.15,
  "validation_group": "location",
  "batch_size": 64,
  "stage1_epochs": 30,
  "stage2_epochs": 80,
  "stage2_lr": 0.0001,
  "metric_coordinate_loss": false,
  "patience": 15,
  "with_mixer": true,
  "mixer_arch": "ap_token",
  "mixer_token_type": "kan",
  "mixer_channel_type": "kan",
  "mixer_epochs": 50,
  "mixer_patience": 15,
  "mixer_batch_size": 64,
  "mixer_blocks": 2,
  "mixer_lr": 0.0003,
  "mixer_weight_decay": 0.00001,
  "mixer_metric_coordinate_loss": false,
  "spatial_clusters": 8,
  "spatial_aux_weight": 0.1,
  "balance_locations": true,
  "augment_gain_std": 0.18,
  "augment_noise_std": 0.07,
  "augment_dropout_prob": 0.1,
  "mixer_isolate_rng": true
}
