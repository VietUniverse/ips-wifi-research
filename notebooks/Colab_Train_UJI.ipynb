    "    fig.tight_layout()\n",
    "    mean_path = output_dir / \"dataset_comparison_mean_error.png\"\n",
    "    fig.savefig(mean_path, dpi=200, bbox_inches=\"tight\")\n",
    "    plt.close(fig)\n",
    "\n",
    "    fig, ax = plt.subplots(figsize=(8, 5))\n",
    "    for record in run_records:\n",
    "        model_dir = Path(record[\"output_dir\"])\n",
    "        errors_by_model = {}\n",
    "        for prediction_path in sorted(model_dir.glob(\"building_*/predictions.csv\")):\n",
    "            pred = pd.read_csv(prediction_path)\n",
    "            error_columns = ([\"error_m\"] if \"error_m\" in pred.columns else\n",
    "                             [c for c in pred.columns if c.endswith(\"_error_m\")])\n",
    "            for column in error_columns:\n",
    "                model_name = (record[\"model_label\"] if column == \"error_m\"\n",
    "                              else column[:-len(\"_error_m\")])\n",
    "                errors_by_model.setdefault(model_name, []).append(pred[column].to_numpy(float))\n",
    "        for model_name, parts in errors_by_model.items():\n",
    "            errors = np.sort(np.concatenate(parts))\n",
    "            ax.step(errors, np.arange(1, len(errors) + 1) / len(errors), where=\"post\",\n",
    "                    label=f\"{record['dataset_label']}: {model_name}\")\n",
    "    ax.set(xlabel=\"Positioning error (m)\", ylabel=\"Fraction of test samples\",\n",
    "           ylim=(0, 1.02), title=\"Positioning error CDF across datasets\")\n",
    "    ax.grid(alpha=.25)\n",
    "    ax.legend(fontsize=8)\n",
    "    fig.tight_layout()\n",
    "    cdf_path = output_dir / \"dataset_comparison_cdf.png\"\n",
    "    fig.savefig(cdf_path, dpi=200, bbox_inches=\"tight\")\n",
    "    plt.close(fig)\n",
    "\n",
    "    print(\"\\nSo sánh tổng hợp theo bộ dữ liệu (test split riêng, không ghép cặp từng mẫu):\")\n",
    "    print(\"Hãy xác nhận tọa độ các bộ dữ liệu đều tính bằng mét trước khi diễn giải mean error.\")\n",
    "    display(table.round(3))\n",
    "    print(\"Đã lưu:\", csv_path, mean_path, cdf_path)\n",
    "    return table\n",
    "\n",
    "run_dirs = []\n",
    "dataset_run_records = []\n",
    "if not selected_models or not selected_preprocess or not selected_preset:\n",
    "    raise ValueError(\"Hãy chọn model, RSS và preset\")\n",
    "base_settings = json.loads((project / selected_preset).read_text())\n",
    "mixer_model_bases = {\n",
    "    \"kan_mixer\": \"bsrbf_kan\", \"kan_spline_mixer\": \"kan\",\n",
    "    \"fastkan_mixer\": \"fastkan\", \"skan_mixer\": \"skan\", \"fckan_mixer\": \"fckan\",\n",
    "}\n",
    "uses_mixer = len(selected_models) == 1 and selected_models[0] in mixer_model_bases\n",
    "run_models = [mixer_model_bases.get(name, name) for name in selected_models]\n",
    "if base_settings.get(\"with_mixer\") != uses_mixer:\n",
    "    raise ValueError(\"Hãy chọn preset Mixer cho KAN-Mixer, hoặc preset thường cho model khác\")\n",
    "print(\"Chạy model:\", selected_models, \"| Tiền xử lý:\", selected_preprocess,\n",
    "      \"| Preset:\", selected_preset)\n",
    "print(\"Cấu hình preset:\", json.dumps(base_settings, ensure_ascii=False, indent=2))\n",
    "print(\"GPU available:\", torch.cuda.is_available())\n",
    "if any(name in {\"bsrbf_kan\", \"kan\", \"fastkan\", \"skan\", \"fckan\"} for name in run_models) and not torch.cuda.is_available():\n",
    "    print(\"Cảnh báo: các biến thể KAN có thể huấn luyện chậm trên CPU.\")\n",
    "\n",
    "for dataset in dataset_runs:\n",
    "    dataset_key, dataset_label, data_dir = dataset[\"key\"], dataset[\"label\"], dataset[\"data_dir\"]\n",
    "    dataset_dir = run_dir / dataset_key\n",
    "    settings = dict(base_settings)\n",
    "    if dataset_key != \"ujiindoorloc\":\n",
    "        settings[\"buildings\"] = [0]\n",
    "    selected_config = Path(\"/content\") / f\"selected_{RUN_NAME}_{dataset_key}.json\"\n",
    "    settings.update(preprocess=selected_preprocess, preprocess_params=preprocess_params)\n",
    "    if selected_family == \"KNN/WKNN\":\n",
    "        settings[\"models\"] = selected_models\n",
    "    selected_config.write_text(json.dumps(settings, ensure_ascii=False), encoding=\"utf-8\")\n",
    "    print(\"\\nDataset:\", dataset_label, \"| train/test:\",\n",
    "          dataset[\"summary\"][\"n_train\"], dataset[\"summary\"][\"n_test\"])\n",
    "\n",
    "    if selected_family == \"KNN/WKNN\":\n",
    "        subprocess.run([sys.executable, \"-u\", \"-m\", \"ips.experiments.knn_cli\",\n",
    "                        \"--config\", str(selected_config), \"--data-dir\", str(data_dir),\n",
    "                        \"--output-dir\", str(dataset_dir)], check=True)\n",
    "        export_floor_metrics(dataset_dir, data_dir)\n",
    "        render_run(dataset_dir)\n",
    "        run_dirs.append(dataset_dir)\n",
    "        dataset_run_records.append({\"dataset_label\": dataset_label, \"output_dir\": dataset_dir,\n",
    "                                    \"model_label\": \", \".join(selected_models)})\n",
    "    else:\n",
    "        for selected_model in run_models:\n",
    "            model_dir = dataset_dir / selected_model\n",
    "            display_name = (model_labels.get(selected_models[0], selected_model)\n",
    "                            if uses_mixer else model_labels.get(selected_model, selected_model))\n",
    "            print(\"Đang chạy:\", dataset_label, \"|\", display_name)\n",
    "            subprocess.run([sys.executable, \"-u\", \"-m\", \"ips.experiments.cli\",\n",
    "                            \"--config\", str(selected_config), \"--model\", selected_model,\n",
    "                            \"--preprocess\", selected_preprocess,\n",
    "                            \"--preprocess-params\", json.dumps(preprocess_params),\n",
    "                            \"--data-dir\", str(data_dir), \"--output-dir\", str(model_dir)], check=True)\n",
    "            export_floor_metrics(model_dir, data_dir)\n",
    "            render_run(model_dir)\n",
    "            run_dirs.append(model_dir)\n",
    "            dataset_run_records.append({\"dataset_label\": dataset_label, \"output_dir\": model_dir,\n",
    "                                        \"model_label\": display_name})\n",
    "\n",
    "if len(dataset_runs) > 1:\n",
    "    compare_dataset_runs(dataset_run_records, run_dir)\n",
    "elif selected_family == \"Neural\" and len(selected_models) > 1:\n",
    "    compare_runs(run_dirs, labels=selected_models)\n",
    "print(\"Kết quả:\", run_dir)\n"
